Screen {
    background: #171a24;
    color: #e5e7eb;
    padding: 0 1;
}

ToolApprovalScreen {
    align: center middle;
    background: #090b12 65%;
}

ChangeReviewScreen {
    align: center middle;
    background: #090b12 65%;
}

#approval-dialog {
    width: 72;
    max-width: 92%;
    height: auto;
    max-height: 92%;
    padding: 1 2;
    border: round #8b5cf6;
    background: #1d2130;
}

#approval-title {
    height: 2;
    color: #c4b5fd;
    text-style: bold;
}

#approval-summary {
    height: auto;
    margin-bottom: 1;
    color: #f8fafc;
}

#approval-arguments {
    height: auto;
    max-height: 7;
    padding: 1;
    overflow-y: auto;
    background: #171a24;
    color: #cbd5e1;
}

#approval-preview-title {
    height: 1;
    margin-top: 1;
    color: #c4b5fd;
    text-style: bold;
}

#approval-preview {
    height: 10;
    padding: 1;
    background: #11141d;
    border: solid #3f3f5a;
}

#approval-scope {
    height: auto;
    margin: 1 0;
    color: #94a3b8;
}

#approval-actions {
    height: 3;
    align-horizontal: right;
}

#approval-actions Button {
    min-width: 14;
    margin-left: 1;
}

#product-line {
    height: 2;
    padding: 0 1;
    color: #c4b5fd;
    text-style: bold;
    content-align: left middle;
}

#welcome-panel {
    height: 16;
    border: round #8b5cf6;
    border-title-color: #c4b5fd;
    border-title-style: bold;
    background: #1d2130;
}

#brand-pane {
    width: 31%;
    height: 100%;
    padding: 1 2;
    border-right: solid #3f3f5a;
    content-align: center middle;
}

#welcome-title {
    height: 2;
    text-align: center;
    text-style: bold;
    color: #f8fafc;
}

#logo-row {
    height: 6;
}

#vortex-logo {
    width: auto;
    height: 6;
    text-align: left;
    color: #a78bfa;
    text-style: bold;
}

#product-description {
    height: 1;
    text-align: center;
    color: #67e8f9;
}

#workspace-path {
    height: 2;
    margin-top: 1;
    text-align: center;
    color: #cbd5e1;
    text-overflow: ellipsis;
}

#info-pane {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

.section-title {
    height: 1;
    color: #a78bfa;
    text-style: bold;
}

.section-copy {
    height: 3;
    color: #e2e8f0;
    margin-top: 1;
}

.section-rule {
    height: 1;
    margin-bottom: 1;
    border-top: solid #4c466d;
}

#interface-status {
    height: 3;
    padding: 1 1 0 1;
    color: #94a3b8;
}

#transcript {
    height: 1fr;
    min-height: 2;
    padding: 0 2;
    color: #e5e7eb;
    overflow-y: auto;
}

ChatMessage {
    width: 1fr;
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    layout: vertical;
}

.message-label {
    width: 1fr;
    height: 1;
}

.message-plain {
    width: 1fr;
    height: auto;
}

.message-markdown {
    width: 1fr;
    height: auto;
    padding: 0;
    background: transparent;
    overflow-y: hidden;
}

.message-state {
    width: 1fr;
    height: auto;
}

.user-message {
    color: #e2e8f0;
}

.assistant-message {
    color: #f8fafc;
}

.error-message {
    color: #fda4af;
}

ToolCallView {
    width: 1fr;
    height: auto;
    min-height: 2;
    margin: 0 0 1 1;
    padding: 0 1;
    border-left: solid #4c466d;
}

.tool-call-summary {
    width: 1fr;
    height: 1;
}

.tool-call-observation {
    width: 1fr;
    height: auto;
    color: #94a3b8;
}

ToolCallView.command-call .tool-call-observation {
    margin-top: 1;
    padding: 1;
    background: #11141d;
    border-left: solid #3f3f5a;
}

ToolCallView.failed {
    border-left: solid #fb7185;
}

ToolCallView.succeeded {
    border-left: solid #4ade80;
}

TurnChangesCard {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 1;
    border: round #4c466d;
    background: #1d2130;
}

.change-card-header {
    width: 1fr;
    height: 3;
}

.change-card-summary {
    width: 1fr;
    height: 3;
    content-align: left middle;
}

.change-card-actions {
    width: auto;
    height: 3;
}

.change-card-actions Button {
    min-width: 10;
    margin-left: 1;
}

.change-card-files {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

.change-card-state {
    width: 1fr;
    height: auto;
    color: #94a3b8;
}

TurnChangesCard.reverted {
    border: round #4ade80;
}

#change-review-dialog {
    width: 90%;
    height: 85%;
    padding: 1 2;
    border: round #8b5cf6;
    background: #1d2130;
}

#change-review-title {
    height: 2;
    color: #c4b5fd;
    text-style: bold;
}

#change-review-summary {
    height: 2;
    color: #94a3b8;
}

#change-review-diff {
    height: 1fr;
    margin-bottom: 1;
    padding: 1;
    background: #11141d;
}

#close-change-review {
    width: 12;
    height: 3;
    align-horizontal: right;
}

#prompt-row {
    height: 3;
    border-top: solid #64748b;
    border-bottom: solid #64748b;
    background: #171a24;
}

#prompt-symbol {
    width: 3;
    padding-left: 1;
    color: #67e8f9;
    text-style: bold;
    content-align: center middle;
}

#prompt {
    width: 1fr;
    height: 3;
    border: none;
    padding: 0 1;
    background: #171a24;
    color: #f8fafc;
}

#prompt:focus {
    border: none;
}

#status-bar {
    height: 1;
    padding-left: 3;
    color: #94a3b8;
    background: #171a24;
}

WelcomeScreen.compact #welcome-panel {
    height: 15;
}

WelcomeScreen.compact #brand-pane {
    width: 1fr;
    border-right: none;
}

WelcomeScreen.compact #info-pane {
    display: none;
}
