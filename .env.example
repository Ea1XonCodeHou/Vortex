# Copy this file to .env in the Vortex repository root.
# Vortex loads this private application config regardless of the active workspace.
DEEPSEEK_API_KEY=

# Optional overrides
VORTEX_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAX_TOOLS_PER_ITERATION=8
MAX_STALLED_ITERATIONS=3
MAX_CONSECUTIVE_TOOL_ERRORS=6
TOOL_TIMEOUT_SECONDS=15
